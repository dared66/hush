#!/bin/bash
set -euo pipefail
# Installer runs this script as root. Restrict migration to the logged-in user's Hush.
console_user=$(/usr/bin/stat -f %Su /dev/console)
if [[ "$console_user" == root || "$console_user" == loginwindow ]]; then exit 0; fi
console_uid=$(/usr/bin/id -u "$console_user")
user_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/cut -d ' ' -f 2-)
[[ -d "$user_home" && "$user_home" != / ]] || exit 1
support="$user_home/Library/Application Support/Hush"
/bin/mkdir -p "$support/Legacy" "$user_home/Library/LaunchAgents"
# Disable only known Hush startup entries; preserve their files as backups.
for label in local.krupa.Hush local.hush.Hush; do
  /bin/launchctl bootout "gui/$console_uid/$label" >/dev/null 2>&1 || true
  old="$user_home/Library/LaunchAgents/$label.plist"
  if [[ -f "$old" ]]; then /bin/mv "$old" "$support/Legacy/$label-$(date +%s).plist"; fi
done
# Stop only the old Hush executable at its verified per-user install path.
for pid in $(/usr/bin/pgrep -u "$console_uid" -x MonitorVolume || true); do
  command=$(/bin/ps -p "$pid" -o command=)
  if [[ "$command" == "$user_home/Applications/Hush.app/Contents/MacOS/MonitorVolume"* ]]; then
    /bin/kill -TERM "$pid"
  fi
done
if [[ -d "$user_home/Applications/Hush.app" ]]; then
  /bin/mv "$user_home/Applications/Hush.app" "$support/Legacy/Hush-$(date +%s).app"
fi
/bin/cp /Applications/Hush.app/Contents/Resources/local.hush.Hush.plist "$user_home/Library/LaunchAgents/local.hush.Hush.plist"
/usr/sbin/chown -R "$console_user":staff "$support"
/usr/sbin/chown "$console_user":staff "$user_home/Library/LaunchAgents/local.hush.Hush.plist"
# Migrate the old standalone uninstaller into the app.
/bin/rm -f '/Applications/Uninstall Hush.command'
/bin/rm -rf '/Library/Application Support/Hush/Uninstaller'
# Hush stores no captured audio and requires no capture permissions in this version.
# Restart Core Audio once so it discovers the new HAL plug-in.
/usr/bin/killall coreaudiod || true
/bin/launchctl bootstrap "gui/$console_uid" "$user_home/Library/LaunchAgents/local.hush.Hush.plist"
exit 0
